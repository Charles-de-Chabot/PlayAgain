generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// --- Énumérations ---

enum Role {
  USER
  ADMIN
}

enum InvoiceStatus {
  PAID
  CANCELLED
  PENDING
}

enum stateProduct {
  NEUF
  EXCELLENT
  BON
  MOYEN
}

// --- Modèles ---

model User {
  id              Int            @id @default(autoincrement())
  username        String         @db.VarChar(50)
  firstname       String?        @db.VarChar(50)
  lastname        String?        @db.VarChar(50)
  email           String         @unique @db.VarChar(100)
  password        String?        @db.VarChar(255)
  profile_picture String?        @db.VarChar(255)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  is_active       Boolean        @default(true)
  is_certified    Boolean        @default(false)
  role            Role           @default(USER)
  
  products        Product[]      @relation("UserProducts")
  addresses       Address[]
  conversations   Conversation[] @relation("UserConversations")
  messages        Message[]      @relation("UserMessages")
  basket          Basket?
  bookmark        Bookmark?
  invoices        Invoice[]
  notifications   Notification[]
}

model Category {
  id       Int       @id @default(autoincrement())
  label    String    @db.VarChar(50)
  types    Type[]
  products Product[]
  sizes    Size[]
}

model Type {
  id          Int       @id @default(autoincrement())
  label       String    @db.VarChar(50)
  category_id Int
  category    Category  @relation(fields: [category_id], references: [id])
  products    Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  label    String    @db.VarChar(50)
  products Product[]
}

model Size {
  id          Int       @id @default(autoincrement())
  label       String    @db.VarChar(20)
  category_id Int
  
  category    Category  @relation(fields: [category_id], references: [id])
  products    Product[]
}

model Product {
  id             Int          @id @default(autoincrement())
  title          String       @db.VarChar(100)
  description    String?      @db.Text
  category_id    Int
  type_id        Int
  brand_id       Int
  state          stateProduct @default(EXCELLENT)
  size_id        Int?
  price          Decimal      @db.Decimal(10, 2)
  stock_quantity Int
  user_id        Int
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  is_sold        Boolean      @default(false)

  
  category       Category     @relation(fields: [category_id], references: [id])
  type           Type         @relation(fields: [type_id], references: [id])
  brand          Brand        @relation(fields: [brand_id], references: [id])
  user           User         @relation("UserProducts", fields: [user_id], references: [id])
  size           Size?        @relation(fields: [size_id], references: [id])
  basket_items   BasketItem[]
  fav_items      FavItem[]
  media          Media[]
  invoice_items  InvoiceItem[]
  conversations  Conversation[]
}

model Media {
  id         Int     @id @default(autoincrement())
  url        String  @db.VarChar(255)
  product_id Int
  product    Product @relation(fields: [product_id], references: [id])
}

model Address {
  id            Int      @id @default(autoincrement())
  user_id       Int
  street_number String?  @db.VarChar(10)
  street_name   String   @db.VarChar(255)
  city          String   @db.VarChar(100)
  zip_code      String   @db.VarChar(20)
  country       String   @db.VarChar(100)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  user          User     @relation(fields: [user_id], references: [id])
}

model Conversation {
  id         Int       @id @default(autoincrement())
  user_id    Int
  product_id Int
  metadata   Json?
  created_at DateTime  @default(now())
  
  user       User      @relation("UserConversations", fields: [user_id], references: [id])
  product    Product   @relation(fields: [product_id], references: [id])
  messages   Message[]
}

model Message {
  id              Int          @id @default(autoincrement())
  content         String       @db.Text
  user_id         Int
  conversation_id Int
  created_at      DateTime     @default(now())
  is_read         Boolean      @default(false)
  metadata        Json?
  
  user            User         @relation("UserMessages", fields: [user_id], references: [id])
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
}

model Basket {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  created_at DateTime     @default(now())
  
  user       User         @relation(fields: [user_id], references: [id])
  items      BasketItem[]
  invoices   Invoice[]
}

model BasketItem {
  id         Int     @id @default(autoincrement())
  basket_id  Int
  product_id Int
  quantity   Int
  unit_price Decimal @db.Decimal(10, 2)
  
  basket     Basket  @relation(fields: [basket_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])
}

model Invoice {
  id           Int           @id @default(autoincrement())
  user_id      Int
  basket_id    Int
  total_price  Decimal       @db.Decimal(10, 2)
  invoice_date DateTime      @default(now())
  status       InvoiceStatus @default(PENDING)
  
  user         User          @relation(fields: [user_id], references: [id])
  basket       Basket        @relation(fields: [basket_id], references: [id])
  items        InvoiceItem[]
}

model InvoiceItem {
  id         Int      @id @default(autoincrement())
  invoice_id Int
  product_id Int
  quantity   Int
  unit_price Decimal  @db.Decimal(10, 2)
  
  invoice    Invoice  @relation(fields: [invoice_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
}

model Bookmark {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  user       User         @relation(fields: [user_id], references: [id])
  items      FavItem[]
}

model FavItem {
  id          Int      @id @default(autoincrement())
  bookmark_id Int
  product_id  Int
  created_at  DateTime @default(now())
  
  bookmark    Bookmark @relation(fields: [bookmark_id], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])

  @@unique([bookmark_id, product_id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String   @db.VarChar(50)
  message    String   @db.Text
  is_opened       Boolean      @default(false)
  metadata        Json?
  created_at      DateTime     @default(now())
  
  user       User     @relation(fields: [user_id], references: [id])
}
