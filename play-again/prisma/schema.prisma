generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// --- Énumérations ---

enum Gender {
  MAN
  WOMAN
  UNISEX
  KIDS
}

enum SportLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum MarketPosition {
  GENERALIST
  TECHNICAL
  PREMIUM
}

enum HandOrientation {
  RIGHT
  LEFT
}

enum BoardStance {
  REGULAR
  GOOFY
}

enum Role {
  USER
  ADMIN
}

enum InvoiceStatus {
  PAID
  CANCELLED
  PENDING
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
}

enum stateProduct {
  NEUF
  EXCELLENT
  BON
  SATISFAISANT
}

// --- Modèles ---

model User {
  id              Int            @id @default(autoincrement())
  username        String?        @db.VarChar(50)
  firstname       String?        @db.VarChar(50)
  lastname        String?        @db.VarChar(50)
  email           String         @unique @db.VarChar(100)
  phone           String?        @db.VarChar(20)
  emailVerified   DateTime?
  password        String?        @db.VarChar(255)
  profile_picture String?        @db.VarChar(255)
  image           String?        @db.VarChar(255)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  is_active       Boolean        @default(true)
  is_certified    Boolean        @default(false)
  role            Role           @default(USER)
  stripeConnectId String?        @unique
  
  sportProfile    SportProfile?
  accounts        Account[]
  sessions        Session[]
  products        Product[]      @relation("UserProducts")
  addresses       Address[]
  conversations   Conversation[] @relation("UserConversations")
  messages        Message[]      @relation("UserMessages")
  basket          Basket?
  bookmarks       Bookmark[]
  invoices        Invoice[]
  notifications   Notification[]
  media           Media[]
  verificationRequests VerificationRequest[]
  reviewedRequests     VerificationRequest[] @relation("ReviewedRequests")
  supportTickets  SupportTicket[]
}

model Category {
  id         Int         @id @default(autoincrement())
  label      String      @db.VarChar(50)
  types      Type[]
  products   Product[]
  promoCodes PromoCode[]
}

model Type {
  id          Int         @id @default(autoincrement())
  label       String      @db.VarChar(50)
  category_id Int
  category    Category    @relation(fields: [category_id], references: [id])
  products    Product[]
  sizes       Size[]
  promoCodes  PromoCode[]
}

model Brand {
  id              Int            @id @default(autoincrement())
  label           String         @db.VarChar(50)
  marketPosition  MarketPosition @default(GENERALIST)
  products        Product[]
}

model Size {
  id          Int       @id @default(autoincrement())
  label       String    @unique @db.VarChar(20)
  
  types       Type[]
  products    Product[]
}

model Product {
  id             Int          @id @default(autoincrement())
  title          String       @db.VarChar(100)
  description    String?      @db.Text
  category_id    Int
  type_id        Int
  brand_id       Int
  state          stateProduct @default(EXCELLENT)
  size_id        Int?
  price          Decimal      @db.Decimal(10, 2)
  stock_quantity Int
  user_id        Int
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  is_sold        Boolean      @default(false)
  is_active      Boolean      @default(true)
  age            Int?         // Année de fabrication
  accessory_included Boolean  @default(false)
  is_shipping    Boolean      @default(true)
  targetGender   Gender       @default(UNISEX)
  levelCategory  SportLevel   @default(BEGINNER)

  
  category       Category     @relation(fields: [category_id], references: [id])
  type           Type         @relation(fields: [type_id], references: [id])
  brand          Brand        @relation(fields: [brand_id], references: [id])
  user           User         @relation("UserProducts", fields: [user_id], references: [id])
  size           Size?        @relation(fields: [size_id], references: [id])
  basket_items   BasketItem[]
  fav_items      FavItem[]
  media          Media[]
  invoice_items  InvoiceItem[]
  conversations  Conversation[]
}

model Media {
  id         Int      @id @default(autoincrement())
  url        String   @db.VarChar(255)
  product_id Int?
  user_id    Int?
  
  product    Product? @relation(fields: [product_id], references: [id])
  user       User?    @relation(fields: [user_id], references: [id])
}

model Address {
  id            Int      @id @default(autoincrement())
  user_id       Int
  street_number String?  @db.VarChar(10)
  street_name   String   @db.VarChar(255)
  city          String   @db.VarChar(100)
  zip_code      String   @db.VarChar(20)
  country       String   @db.VarChar(100)
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  user          User     @relation(fields: [user_id], references: [id])
  invoices      Invoice[]
}

model Conversation {
  id              Int       @id @default(autoincrement())
  user_id         Int
  product_id      Int?
  isSupportThread Boolean   @default(false)
  metadata        Json?
  created_at      DateTime  @default(now())
  
  user       User      @relation("UserConversations", fields: [user_id], references: [id])
  product    Product?  @relation(fields: [product_id], references: [id])
  messages   Message[]
}


model Message {
  id              Int          @id @default(autoincrement())
  content         String       @db.Text
  user_id         Int
  conversation_id Int
  created_at      DateTime     @default(now())
  is_read         Boolean      @default(false)
  metadata        Json?
  
  user            User         @relation("UserMessages", fields: [user_id], references: [id])
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
}

model Basket {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  created_at DateTime     @default(now())
  
  user       User         @relation(fields: [user_id], references: [id])
  items      BasketItem[]
  invoices   Invoice[]
}

model BasketItem {
  id         Int     @id @default(autoincrement())
  basket_id  Int
  product_id Int
  quantity   Int
  unit_price Decimal @db.Decimal(10, 2)
  
  basket     Basket  @relation(fields: [basket_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])
}

model Invoice {
  id                  Int           @id @default(autoincrement())
  user_id             Int
  basket_id           Int
  total_price         Decimal       @db.Decimal(10, 2)
  commission          Decimal?      @db.Decimal(10, 2)
  shipping_fee        Decimal?      @db.Decimal(10, 2)
  payment_intent_id   String?       @unique
  is_disputed         Boolean       @default(false)
  buyer_security_code String?
  address_id          Int?
  invoice_date        DateTime      @default(now())
  status              InvoiceStatus @default(PENDING)
  tracking_number     String?       @unique
  delivered_at        DateTime?
  
  user                User          @relation(fields: [user_id], references: [id])
  basket              Basket        @relation(fields: [basket_id], references: [id])
  address             Address?      @relation(fields: [address_id], references: [id])
  items               InvoiceItem[]
}

model InvoiceItem {
  id         Int      @id @default(autoincrement())
  invoice_id Int
  product_id Int
  quantity   Int
  unit_price Decimal  @db.Decimal(10, 2)
  
  invoice    Invoice  @relation(fields: [invoice_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
}

model Bookmark {
  id         Int          @id @default(autoincrement())
  user_id    Int
  name       String       @db.VarChar(100) @default("Favoris")
  user       User         @relation(fields: [user_id], references: [id])
  items      FavItem[]

  @@unique([user_id, name])
}

model FavItem {
  id          Int      @id @default(autoincrement())
  bookmark_id Int
  product_id  Int
  created_at  DateTime @default(now())
  
  bookmark    Bookmark @relation(fields: [bookmark_id], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])

  @@unique([bookmark_id, product_id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String   @db.VarChar(50)
  message    String   @db.Text
  is_opened       Boolean      @default(false)
  metadata        Json?
  created_at      DateTime     @default(now())
  
  user       User     @relation(fields: [user_id], references: [id])
}

model Account {
  id                 Int     @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SportProfile {
  id              Int              @id @default(autoincrement())
  userId          Int              @unique
  user            User             @relation(fields: [userId], references: [id])
  
  gender          Gender?          @default(UNISEX)
  height          Int?             // Taille en cm
  weight          Int?             // Poids en kg
  shoeSize        Float?           // Pointure EU
  
  level           SportLevel       @default(BEGINNER)
  frequency       Int?             // Séances par semaine
  
  handOrientation HandOrientation? @default(RIGHT)
  boardStance     BoardStance?     @default(REGULAR)
  
  interests       Json?            // ["football", "tennis"]
  
  skills          SportSkill[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model SportSkill {
  id             Int          @id @default(autoincrement())
  sportProfileId Int
  sportProfile   SportProfile @relation(fields: [sportProfileId], references: [id], onDelete: Cascade)
  
  sportName      String       @db.VarChar(50)
  level          SportLevel   @default(BEGINNER)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([sportProfileId, sportName])
}

model BrandExpertise {
  id        Int      @id @default(autoincrement())
  brandName String   @db.VarChar(50)
  rangeName String   @db.VarChar(50)
  level     SportLevel
  confidence Float   @default(1.0)
  createdAt DateTime @default(now())

  @@unique([brandName, rangeName])
}

// --- Énumérations de vérification d'identité ---

enum VerificationStatus {
  PENDING           // En attente de revue administrative
  PROCESSING_AI     // En cours de traitement par l'IA (pour V2)
  APPROVED          // Validée avec succès
  REJECTED          // Refusée
}

enum VerificationMethod {
  MANUAL            // Revue par un administrateur humain
  AI                // Revue automatisée par l'intelligence artificielle
}

// --- Modèle de Requête de Vérification d'Identité ---

model VerificationRequest {
  id                  Int                @id @default(autoincrement())
  userId              Int
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status              VerificationStatus @default(PENDING)
  method              VerificationMethod @default(MANUAL)
  
  // Coordonnées saisies par l'utilisateur lors du formulaire (pour comparaison de conformité)
  submittedEmail      String             @db.VarChar(100)
  submittedPhone      String             @db.VarChar(20)
  submittedStreetNumber String?          @db.VarChar(10) // Numéro de rue (ex: "12bis", optionnel)
  submittedStreetName   String             @db.VarChar(255) // Nom de la rue
  submittedCity       String             @db.VarChar(100)
  submittedZip        String             @db.VarChar(20)
  submittedCountry    String             @db.VarChar(100)
  
  // URLs des documents stockés (jusqu'à 2 photos maximum autorisées pour l'ID + 1 pour le selfie)
  idCardPhoto1Url     String             @db.VarChar(255) // Première photo obligatoire (ex: Recto ou Page Passeport)
  idCardPhoto2Url     String?            @db.VarChar(255) // Deuxième photo optionnelle (ex: Verso s'il existe)
  selfieUrl           String             @db.VarChar(255) // Selfie avec le mot manuscrit "Play Again" (Strictement obligatoire et unique)
  
  // En cas de refus, l'administrateur (ou l'IA) indique pourquoi pour guider l'utilisateur
  rejectionReason     String?            @db.Text
  
  // Qui a traité la demande (utile pour l'audit)
  reviewedById        Int?
  reviewedBy          User?              @relation("ReviewedRequests", fields: [reviewedById], references: [id])
  
  // Données techniques de l'IA (scores de confiance, logs d'analyses faciales)
  aiMetadata          Json?
  
  submittedAt         DateTime           @default(now())
  reviewedAt          DateTime?
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model SupportTicket {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String?          @db.VarChar(100)
  content   String           @db.Text
  status    String           @db.VarChar(20) // "NEW", "IN_PROGRESS", "RESOLVED"
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SupportMessage {
  id           Int           @id @default(autoincrement())
  ticketId     Int
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId     Int
  isAdminReply Boolean       @default(false)
  content      String        @db.Text
  createdAt    DateTime      @default(now())
}

model PromoCode {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  discountPercent Int
  minBasketAmount Decimal   @db.Decimal(10, 2)
  isActive        Boolean   @default(true)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  categoryId      Int?
  category        Category? @relation(fields: [categoryId], references: [id])
  typeId          Int?
  type            Type?     @relation(fields: [typeId], references: [id])
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  adminEmail String
  action     String   // ex: "USER_SOFT_DELETE", "LITIGE_RESOLVED", "PROMO_CODE_CREATED"
  targetId   Int?     // ID de l'élément affecté
  metadata   Json?    // Motif ou variables additionnelles
  ipAddress  String?
  createdAt  DateTime @default(now())
}

